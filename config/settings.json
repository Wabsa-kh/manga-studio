{
  "state_root": "state",
  "manga_list_file": "config/manga.json",
  "max_run_minutes": 240,
  "short_wait_seconds": 120,
  "part_minutes": [
    45,
    60
  ],
  "daily_target_minutes": [
    60,
    120
  ],
  "words_per_minute": 207,
  "reader_batch_pages": 2,
  "unit_pages": 40,
  "prefetch_units": 2,
  "tts_batch_words": 2200,
  "part_audio_batching": true,
  "minimum_free_gb": 4,
  "storage": {
    "backend": "rclone",
    "remote_env": "MANGA_STORE_REMOTE"
  },
  "download": {
    "backend": "colab",
    "provider": "weebcentral",
    "chapter_limit_per_run": 0,
    "threads": 2,
    "delay_seconds": 1.5
  },
  "upscale": {
    "enabled": true,
    "backend": "colab",
    "scale": 4,
    "color_mode": "bw",
    "gpu": "T4",
    "checkpoint_pages": 16,
    "checkpoint_seconds": 60
  },
  "providers": {
    "reader": {
      "provider": "google",
      "model": "gemini-3.5-flash-lite",
      "daily_requests": 440,
      "rpm": 8
    },
    "writer": {
      "provider": "google",
      "model": "gemini-4-hydrogen",
      "daily_requests": 18,
      "rpm": 3,
      "fallbacks": [
        {
          "provider": "nim",
          "model": "nvidia/nemotron-3.5-super-vl-120b-a12b",
          "images": false,
          "enable_thinking": true,
          "temperature": 0.8,
          "top_p": 0.95,
          "max_tokens": 65536,
          "timeout_seconds": 420,
          "daily_requests": 100,
          "rpm": 8
        },
        {
          "provider": "openrouter",
          "model": "nvidia/nemotron-3.5-super-vl:free",
          "images": false,
          "temperature": 0.8,
          "top_p": 0.95,
          "max_tokens": 65536,
          "timeout_seconds": 420,
          "daily_requests": 50,
          "rpm": 8
        }
      ]
    },
    "tts": {
      "provider": "google",
      "model": "gemini-3.8-flash-tts",
      "daily_requests": 9,
      "rpm": 2
    }
  },
  "render": {
    "engine": "subpixel_v11",
    "width": 1280,
    "height": 720,
    "fps": 30,
    "zoom_relax": 0.94,
    "move_seconds": 0.62,
    "minimum_hold": 2.0,
    "yaw_degrees": 0.65,
    "transition_seconds": 0.28
  },
  "youtube": {
    "enabled": true,
    "privacy": "private",
    "prepare_metadata": true,
    "max_uploads_per_run": 1
  },
  "quota_limits": {
    "nim": {
      "rpm": 24,
      "daily_requests": 500
    },
    "openrouter": {
      "rpm": 20,
      "daily_requests": 50
    }
  }
}
